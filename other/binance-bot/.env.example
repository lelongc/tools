# ==========================================
# CẤU HÌNH BINANCE GEMINI AUTO TRADING BOT
# ==========================================

# 1. API KEY BINANCE (Yêu cầu bật quyền: Enable Futures Trading, KHÔNG bật quyền Rút tiền / Withdrawal)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Đặt True nếu muốn chạy thử trên mạng Testnet của Binance (không mất tiền thật)
USE_TESTNET=False

# 2. GOOGLE GEMINI API KEY (Miễn phí 100% tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 3. THIẾT LẬP TRADE
# Cặp coin khuyên dùng: SOL/USDT (Biến động 2-3% trong 2-4 tiếng, thanh khoản cực lớn)
SYMBOL=SOL/USDT

# Đòn bẩy (x3 đến x5)
LEVERAGE=5

# Vốn ký quỹ mỗi lệnh (USDT). Ví dụ có 8$, chỉ vào 5$ để lại 3$ dự phòng an toàn
MARGIN_USDT=5.0

# Mục tiêu chốt lời (+0.5$ đóng lệnh)
PROFIT_TARGET_USDT=0.50

# Cắt lỗ bảo hiểm (bảo vệ không bao giờ cháy hết 8$, ví dụ -0.8$ thì cắt)
STOP_LOSS_USDT=0.80

# Thời gian nghỉ sau khi chốt lệnh (phút)
COOLDOWN_MINUTES=15

# Độ tự tin tối thiểu của Gemini để vào lệnh (70/100)
MIN_CONFIDENCE=70
