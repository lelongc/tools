{
   "action": {
      "default_icon": {
         "128": "assets/icons/icon16.png",
         "16": "assets/icons/icon16.png",
         "48": "assets/icons/icon16.png"
      }
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "description": "Auto-post in multiple Facebook groups. Save time with automation, link sharing, and content scheduling.",
   "host_permissions": [ "https://script.google.com/*" ],
   "icons": {
      "128": "assets/icons/icon16.png",
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon16.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Facebook Groups Auto Poster | Post Scheduler & Automation Assistant",
   "permissions": [ "activeTab", "storage", "unlimitedStorage", "system.display", "scripting", "alarms", "https://script.google.com/*" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.11",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "popup.html", "schedual.html", "schedual.js", "popup.js", "bootstrap.bundle.min.js", "assets/icons/*" ]
   } ]
}
