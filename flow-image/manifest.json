{
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [
            "qw-4d5e6f7a.js"
         ],
         "matches": [
            "https://flow.google.com/*",
            "https://labs.google/fx/*/tools/flow/*",
            "https://labs.google/fx/tools/flow/*"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "js": [
            "zr-7f2a1b3c.js"
         ],
         "matches": [
            "https://labs.google/fx/*/tools/flow/*",
            "https://labs.google/fx/tools/flow/*"
         ],
         "run_at": "document_start",
         "world": "ISOLATED"
      }
   ],
   "description": "Auto Flow on Google Flow. Batch generate Veo 3.1 videos & Nano Banana Pro images, auto 4K upscale, auto-download.",
   "host_permissions": [
      "https://labs.google/*",
      "https://flow.google.com/*",
      "https://turboflow-server.vercel.app/*",
      "https://*.lemonsqueezy.com/*"
   ],
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "TurboFlow - Auto Flow on Google Flow (Unlimited Pro Local)",
   "permissions": [
      "identity",
      "sidePanel",
      "scripting",
      "storage",
      "tabs",
      "downloads",
      "activeTab",
      "alarms"
   ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "version": "9.9.9",
   "web_accessible_resources": [
      {
         "matches": [
            "https://flow.google.com/*",
            "https://labs.google/*"
         ],
         "resources": [
            "rc-lib.js"
         ]
      }
   ]
}