func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_detect_or_load_locale()

func _detect_or_load_locale() -> void:
	var saved_lang = _load_saved_locale()
	if saved_lang != "":
		current_locale = saved_lang
	else:
		var os_lang = OS.get_locale_language().to_lower()
		if os_lang == "zh":
			var full_locale = OS.get_locale().to_lower()
			if "tw" in full_locale or "hant" in full_locale or "hk" in full_locale:
				current_locale = "zh_TW"
			else:
				current_locale = "zh"
		elif os_lang in SUPPORTED_LOCALES:
			current_locale = os_lang
		else:
			current_locale = "en"
	_save_locale()

func tr_key(key: String, params: Array = []) -> String:
	var dict = translations.get(current_locale, translations["en"])
	var text = dict.get(key, "")
	if text == "":
		text = translations["en"].get(key, key)
	if params.size() > 0:
		return text % params
	return text

func set_locale(loc: String) -> void:
	if loc in SUPPORTED_LOCALES and loc != current_locale:
		current_locale = loc
		_save_locale()
		emit_signal("locale_changed", current_locale)

func toggle_next_locale() -> String:
	var idx = SUPPORTED_LOCALES.find(current_locale)
	if idx == -1:
		idx = 0
	var next_idx = (idx + 1) % SUPPORTED_LOCALES.size()
	current_locale = SUPPORTED_LOCALES[next_idx]
	_save_locale()
	emit_signal("locale_changed", current_locale)
	return current_locale

func get_current_locale_name() -> String:
	return LOCALE_NAMES.get(current_locale, "English")

func get_current_short_code() -> String:
	return LOCALE_SHORT_CODES.get(current_locale, "EN")

func _save_locale() -> void:
	var config = ConfigFile.new()
	config.load("user://puffy_progress.cfg")
	config.set_value("settings", "locale", current_locale)
	config.save("user://puffy_progress.cfg")

func _load_saved_locale() -> String:
	var config = ConfigFile.new()
	var err = config.load("user://puffy_progress.cfg")
	if err == OK:
		var val = config.get_value("settings", "locale", "")
		if val in SUPPORTED_LOCALES:
			return val
	return ""
