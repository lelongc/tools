; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cluck & Drop: Bunker Buster"
config/description="Physics Puzzle Drop Bomb Eggs Game"
run/main_scene="res://scenes/ui/MainMenu.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]









GameManager="*res://scripts/core/GameManager.gd"
SoundManager="*res://scripts/core/SoundManager.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
LocalizationManager="*res://scripts/core/LocalizationManager.gd"
AdsManager="*res://scripts/core/AdsManager.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

