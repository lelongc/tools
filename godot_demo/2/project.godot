; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but for standard project initialization it is generated here.

config_version=5

[application]

config/name="The Bleeding Comb: Obscure Resurrection"
run/main_scene="res://scenes/Main2D.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

PlatformBridge="*res://scripts/autoload/PlatformBridge.gd"
SaveSystem="*res://scripts/autoload/SaveSystem.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
