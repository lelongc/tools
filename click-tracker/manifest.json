{
  "manifest_version": 3,
  "name": "Click Tracker — DOM Action Recorder",
  "version": "1.0.0",
  "description": "Ghi lại mọi thao tác (click, gõ, chọn file, cuộn...) trên trình duyệt và xuất ra JSON cho AI đọc.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/tracker.js"],
      "css": ["content/tracker.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
