{
  "manifest_version": 3,
  "name": "Web Macro Scheduler",
  "version": "1.0.0",
  "description": "Tự động ghi lại và phát lại thao tác web theo thời gian hẹn trước.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
