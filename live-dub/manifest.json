{
   "action": {
      "default_icon": "/imgs/icon128.png",
      "default_popup": "popup.html",
      "default_title": "__MSG_appName__"
   },
   "author": "DubTab",
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "toggle-capture": {
         "description": "Toggle Start/Stop Capture",
         "suggested_key": {
            "default": "Alt+Shift+S",
            "mac": "Alt+Shift+S"
         }
      }
   },
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "host_permissions": [ "https://*.cloudfunctions.net/*", "https://*.soniccaption.com/*", "https://*.posthog.com/*", "https://*.firebaseapp.com/*", "https://*.dubtab.com/*", "https://*.r2.dev/*" ],
   "icons": {
      "128": "/imgs/icon128.png",
      "16": "/imgs/icon128.png",
      "32": "/imgs/icon128.png",
      "48": "/imgs/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "identity", "identity.email", "tabs", "activeTab", "storage", "downloads", "tabCapture", "offscreen", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.5",
   "web_accessible_resources": [ {
      "matches": [ "https://*/*" ],
      "resources": [ "imgs/*" ]
   } ]
}
